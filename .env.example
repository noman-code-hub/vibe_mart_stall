# Local development only.
#
# In production the key lives in WordPress:
#   Settings → Vibe Mart, or
#   define( 'VIBE_MART_REMOVE_BG_API_KEY', '...' ); in wp-config.php
#
# Get a key at https://www.remove.bg/api
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Upload limits for the dev handler (10 MB default)
MAX_UPLOAD_BYTES=10485760

# Optional: proxy /wp-json from Vite (localhost:3000) to a real WordPress site
# that has the Vibe Mart plugin active. Leave unset to use the local auth mock.
# Example: WP_PROXY_TARGET=http://localhost/vibe-mart
# WP_PROXY_TARGET=