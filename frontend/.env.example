# Get a key at https://www.remove.bg/api
# Used by local Vite middleware only (npm run dev).
# Production: Settings → Vibe Mart, or define VIBE_MART_REMOVE_BG_API_KEY in wp-config.php
REMOVE_BG_API_KEY=your_remove_bg_api_key_here
MAX_UPLOAD_BYTES=10485760

# Optional: forward /wp-json to WordPress (plugin must be active).
# Leave unset to use the built-in local auth mock at /wp-json/vibe-mart/v1/auth/*
# WP_PROXY_TARGET=http://localhost/vibe-mart
